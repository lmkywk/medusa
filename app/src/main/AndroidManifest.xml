<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      usesCleartextTraffic 保留为 true：配置页的「自定义AI | 测试响应」按钮在模块 App 进程里
      请求用户自填的接口地址，该地址可能是 http 的局域网/自建端点，禁明文会让测试直接失败。
    -->
    <application
        android:name=".SesameApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:description="@string/module_description"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:targetApi="q">

        <activity
            android:name=".ui.miuix.MiuixMainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            tools:targetApi="n">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.MedusaNoticeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.medusa.alipay.notice.EVENT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".notify.MedusaNotificationListener"
            android:exported="true"
            android:label="美杜莎通知净化"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".ui.miuix.MiuixAiActivity"
            android:exported="false"
            android:label="AI 分析" />

        <activity
            android:name=".ui.miuix.MiuixSettingsActivity"
            android:exported="true"
            android:resizeableActivity="true"
            tools:targetApi="n" />

        <activity
            android:name=".ui.miuix.MiuixGroupFieldsActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixDomainActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixTaskListActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixBackupActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixSelectionEditActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixSchedulerActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixPlanEditActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixTestModeActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixPlanFlowActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixExtensionsActivity"
            android:exported="true"
            android:resizeableActivity="true"
            tools:targetApi="n" />

        <activity
            android:name=".ui.miuix.MiuixLogViewerActivity"
            android:exported="true"
            android:resizeableActivity="true"
            tools:targetApi="n" />

        <activity
            android:name=".ui.miuix.MiuixFriendStatsActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixAboutActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixCreditsActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixSystemStatusActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixRunHistoryActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixTaskPickerActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixPlanComposeActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixImageCropActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity-alias
            android:name=".ui.MainActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="io.github.aw1y2z.sesame.ui.miuix.MiuixMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>

</manifest>